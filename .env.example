# FraudFusion environment variable reference.
# Copy to .env and fill in values for local development. NEVER commit a real
# .env (gitignored); this file documents every variable referenced in the repo.

# ---------------------------------------------------------------------------
# Shared / identity (Keycloak)
# ---------------------------------------------------------------------------
# Base URL of the Keycloak server. HTTPS required by all fail-closed services
# unless KEYCLOAK_INSECURE_HTTP=true (local dev / in-cluster plaintext only).
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=fraudfusion
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Comma-separated realm roles accepted by the fraud detectors.
KEYCLOAK_REQUIRED_ROLES=fraud_analyst,fraud_operator,admin
# Allow plain-HTTP Keycloak URLs (local-e2e compose, in-cluster staging).
KEYCLOAK_INSECURE_HTTP=true
# Full introspection endpoint override (some Go services accept this instead
# of KEYCLOAK_URL).
KEYCLOAK_INTROSPECTION_URL=

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
# Postgres connection string (Python services + chargeback/insider detectors).
DATABASE_URL=postgresql://fraudfusion:local_e2e_only@localhost:54329/fraudfusion_e2e?sslmode=disable
# Dissected Postgres settings (Go detectors that build the DSN themselves).
DB_HOST=localhost
DB_PORT=54329
DB_USER=fraudfusion
DB_PASSWORD=local_e2e_only
DB_NAME=fraudfusion_e2e
DB_SSLMODE=disable
# Skip TLS verification for local dev databases (fail-closed otherwise).
DB_ALLOW_INSECURE=true
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=20

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_TLS=false
REDIS_TLS_SERVER_NAME=
REDIS_RATE_KEY_PREFIX=fraudfusion:rate
REDIS_REPLAY_KEY_PREFIX=fraudfusion:replay

# ---------------------------------------------------------------------------
# Go orchestrator (orchestrator/go, port 8000)
# ---------------------------------------------------------------------------
PORT=8000
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=fraudfusion-events
DAPR_URL=http://localhost:3500
DAPR_APP_ID=fraudfusion-orchestrator
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=fraudfusion-journeys
PERMIFY_URL=http://localhost:3476
PERMIFY_API_KEY=
PERMIFY_BOOTSTRAP_TENANT=t1
PERMIFY_BOOTSTRAP_ADMIN=false
PERMIFY_SEED_JOURNEYS=false
APISIX_ADMIN_URL=http://localhost:9180
APISIX_API_KEY=
TIGERBEETLE_ADDRESSES=localhost:3000
LAKEHOUSE_URL=http://localhost:8090
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Fraud detectors (services/go/*, services/python/*)
# ---------------------------------------------------------------------------
# HTTP listen address (chargeback :8091, insider :8090 override LISTEN_ADDR;
# other detectors use PORT).
LISTEN_ADDR=
# aml-monitor -> aml-ml-service seam.
AML_ML_SERVICE_URL=http://localhost:8100
# CBN/NFIU regulatory reporting (aml-monitor SAR filing stub).
CBN_NFIU_ENDPOINT=
CBN_API_KEY=
EFCC_ENDPOINT=
EFCC_API_KEY=
# Telco verification for sim-swap detector.
TELCO_VERIFICATION_URL=
TELCO_VERIFICATION_API_KEY=
# account-takeover-detector model blending.
ATO_ARTIFACT_DIR=ml/artifacts/fraud_net/v1
ATO_MODEL_PATH=
ATO_MODEL_BLEND_WEIGHT=0.6
# identity-theft-detector thresholds.
IDENTITY_MATCH_THRESHOLD=0.8
IDENTITY_EMBEDDING_DIM=128

# kyc-api document verification (services/python/doc-verification engine,
# wired via app/docverification.py). The local cv2 layer always runs; these
# variables configure the OPTIONAL remote/heavy backends. Leave unset for
# honest degradation (layers report unavailable; nothing is fabricated).
# Path override for the shared doc-verification package (default: repo-relative).
DOCVERIFICATION_PATH=
# OpenKYC-compatible remote IDV server (Gradio-style /gradio_api/call/*
# endpoints; original reimplementation of the FaceOnLive API SHAPE — that
# project has no license, no code is copied). Powers /biometric/face-match,
# /biometric/liveness when set.
IDV_SERVER_URL=
IDV_ACCESS_TOKEN=
IDV_TIMEOUT_S=30
# ollama vision model for structured Nigerian document field extraction
# (same conventions as kg-qa: OLLAMA_URL + OLLAMA_TIMEOUT_S).
OLLAMA_URL=
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_TIMEOUT_S=30
# Local PaddleOCR kill-switch (requires the optional paddleocr+paddlepaddle
# packages; see services/python/doc-verification/requirements.txt).
PADDLEOCR_ENABLED=true

# ---------------------------------------------------------------------------
# ML serving / routing (mlops/serving)
# ---------------------------------------------------------------------------
AML_MODEL_PATH=
AML_ARTIFACT_DIR=ml/artifacts/fraud_net/v1
AML_MODEL_NAME=fraud_net
AML_MODEL_VERSION=v1
AML_HIGH_RISK_THRESHOLD=0.8
AML_MEDIUM_RISK_THRESHOLD=0.5
# model_router.py (port 8200) A/B experiment lane.
EXPERIMENT_CONFIG=mlops/experiments/champion_challenger.yaml
ROUTER_LOG_DIR=mlops/data/router_log
ROUTER_RELOAD_URL=http://localhost:8200/v1/route/reload
ROUTER_UPSTREAM_TIMEOUT=5.0

# ---------------------------------------------------------------------------
# ML training / lakehouse / monitoring (ml, mlops)
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_DB_PASSWORD=mlflow_local_e2e
LAKEHOUSE_DIR=mlops/data/lakehouse
LABELS_FILE=
EXPORT_START=
EXPORT_END=
EXPORT_QUERY=
RETRAIN_THRESHOLD=
RETRAIN_EPOCHS=
RAY_NUM_WORKERS=2
# Drift / performance monitors.
DRIFT_PSI_WARN=0.1
DRIFT_PSI_ALERT=0.25
DRIFT_KS_ALERT=0.1
DRIFT_SCORE_COLUMN=risk_score
PERF_MIN_PRECISION=0.8
PERF_MIN_RECALL=0.7
PERF_SCORE_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# land-verification-service (port 8002)
# ---------------------------------------------------------------------------
LAND_VERIFY_DB=services/land-verification-service/data/land_verification.db
LAND_VERIFY_REPORT_DIR=services/land-verification-service/reports/output

# ---------------------------------------------------------------------------
# onboarding-service (services/python/onboarding-service, port 8085)
# ---------------------------------------------------------------------------
ONBOARDING_DB_PATH=services/python/onboarding-service/data/onboarding.db
# Staff realm role allowed to review/approve/reject API key requests.
ONBOARDING_ADMIN_ROLE=onboarding_admin
# Compose override for the onboarding-service Keycloak client secret.
ONBOARDING_CLIENT_SECRET=local_e2e_only

# ---------------------------------------------------------------------------
# ledger-command / ledger-control-service (port 8098)
# ---------------------------------------------------------------------------
STORAGE_READ_ONLY=false
STORAGE_WORM_MODE=false
AUDIT_LOG_DIR=
AUDIT_ANCHOR_FILE=
AUDIT_ANCHOR_ENDPOINT=
AUDIT_HMAC_KEY=
AUDIT_HMAC_KEY_URI=
AUDIT_RETENTION_FLOOR_DAYS=2555
FRAUDFUSION_ENCRYPTION_MASTER_KEY=
FRAUDFUSION_ENCRYPTION_KEY_VERSION=
SETTLEMENT_PROVIDER_NAME=
SETTLEMENT_PROVIDER_CALLBACK_HMAC_SECRET=
SETTLEMENT_PROVIDER_ALLOWED_HOSTS=
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
# Test/benchmark only.
LEDGER_INTEGRATION_DATABASE_URL=
LEDGER_STRESS_TENANTS=6
LEDGER_STRESS_TRANSACTIONS_PER_TENANT=20
LEDGER_STRESS_CONCURRENCY=12
LEDGER_OUTBOX_BENCHMARK_DATABASE_URL=
LEDGER_OUTBOX_BENCHMARK_OUTPUT=
LEDGER_OUTBOX_BENCHMARK_ALLOW_PRODUCTION=false
LEDGER_DR_PRIMARY_DB=
LEDGER_DR_ISOLATED_DB=

# ---------------------------------------------------------------------------
# Web frontends (build-time; Vite inlines these)
# ---------------------------------------------------------------------------
# Standard variable for ALL web apps (frontend, kyc-frontend, backoffice-ui,
# ml-onboarding-portal). VITE_API_URL is deprecated (kyc-frontend migrated).
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Local e2e / misc
# ---------------------------------------------------------------------------
# Bearer token accepted by local-e2e/go-mobile-mock (contract tests only).
LOCAL_E2E_TOKEN=local-contract-token
ENVIRONMENT=development
APP_VERSION=dev
LOG_DIR=

# --- Round-3 additions ---
# Nigerian AML compliance (aml-monitor)
CTR_THRESHOLD_NGN=10000000        # CBN cash transaction report threshold
STR_SLA_HOURS=72                  # NFIU suspicious-transaction report deadline
# Graph database (optional; GNN pipeline degrades gracefully without it)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
# Temporal journey activities (temporal-orchestrator)
LAND_VERIFICATION_URL=http://land-verification-service:8080
BOOKING_SERVICE_URL=http://booking-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080
# Insider-fraud detector tuning
COLLUSION_MIN_SHARED_RESOURCES=2
# Storage anti-wipe (ransomware guard kill switch: true|false)
STORAGE_RANSOMWARE_GUARD=true

# --- Round-6 additions ---
# Monetization / billing-service (:8400)
BILLING_ADMIN_ROLE=billing_admin          # Keycloak role allowed to manage plans/keys
BILLING_KEY_ENV=dev                        # API-key prefix env marker (ffk_dev_/ffk_live_)
BILLING_INVOICE_DUE_DAYS=14
BILLING_DUNNING_GRACE_DAYS=7               # past_due grace before key suspension
BILLING_USAGE_FLUSH_THRESHOLD=100          # buffered usage events before flush
BILLING_USAGE_FLUSH_INTERVAL_SECONDS=30
# National intelligence service (:8500)
INTEL_ARTIFACT_DIR=ml/artifacts/national_intelligence/v1
INTEL_SUPPRESS_MIN_N=30                    # NDPA k-anonymity suppression threshold
# Events consumer (fraudfusion-events -> events_archive)
EVENTS_SOURCE=auto                         # kafka|filetail|auto (fail-closed when unset)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=fraudfusion-events
EVENTS_FILE_DIR=mlops/data/lakehouse/events
EVENTS_BATCH_SIZE=500
EVENTS_DB=                                 # postgres DSN for events_archive
# Auth consolidation / Permify tenant binding (authcommon)
PERMIFY_URL=                               # unset = tenant binding checks claim only
PERMIFY_ENFORCE=false                      # fail-closed 403s when true + PERMIFY_URL set
# Detector tuning (Round-6 caveat fixes)
HISTORY_WINDOW_DAYS=90                     # chargeback unified history window
REPUTATION_CACHE_TTL_SECONDS=3600          # crypto wallet reputation cache
AFTER_HOURS_TIMEZONE=Africa/Lagos          # insider after-hours scoring
SEC_REGISTRY_CSV=                          # investment: SEC Nigeria licensee CSV path
# Security manager
JWT_SECRET=                                # REQUIRED — security_manager refuses to boot without it
JWT_SECRET_PREVIOUS=                       # previous secret accepted during rotation window
# Backoffice UI (Vite)
VITE_BACKOFFICE_API_URL=http://backoffice-api:8087

# --- Round-9 additions ---
# Webhook service (:8088) — tenant endpoint CRUD + HMAC-signed delivery.
WEBHOOK_DB_PATH=services/python/webhook-service/data/webhooks.db
# Shared service-to-service token guarding POST /internal/events. The
# webhook service FAILS CLOSED (503 on intake) when unset. Emitters
# (kyc-api, onboarding-service, identity-theft-detector) send it as
# X-Internal-Token.
WEBHOOK_INTERNAL_TOKEN=local_e2e_only
# Base URL of the webhook service for emitter services. When unset, emitters
# NO-OP (debug log) — fire-and-forget contract.
WEBHOOK_SERVICE_URL=http://webhook-service:8088
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=5     # per-attempt POST timeout
WEBHOOK_WORKER_POLL_SECONDS=1          # in-process delivery worker poll
WEBHOOK_BREAKER_THRESHOLD=10           # consecutive dead-letters before an
                                       # endpoint's circuit breaker opens
# API-key seam (billing-service introspection): billing guards
# POST /internal/api-keys/introspect with this shared token (FAIL-CLOSED 503
# when unset); data-plane services (kyc-api, intel-service) present it as
# X-Internal-Token when validating X-API-Key keys.
BILLING_INTERNAL_TOKEN=local_e2e_only
# Full URL of billing's introspection endpoint for data-plane services.
# When unset, API-key auth on kyc-api/intel-service fails closed (503).
BILLING_INTROSPECT_URL=http://billing-service:8400/internal/api-keys/introspect
